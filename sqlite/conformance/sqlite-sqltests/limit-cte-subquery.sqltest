@database :memory:

test cte-visible-in-limit-subquery {
    WITH c AS (SELECT 1 AS x) SELECT x FROM c LIMIT (SELECT count(*) FROM c);
}
expect {
    1
}

test cte-visible-in-compound-limit-subquery {
    WITH c AS (SELECT 2 AS x) SELECT 1 UNION ALL SELECT 2 LIMIT (SELECT x FROM c);
}
expect {
    1
    2
}

test cte-visible-in-compound-offset-subquery {
    WITH c AS (SELECT 1 AS x) SELECT 1 UNION ALL SELECT 2 LIMIT 1 OFFSET (SELECT x FROM c);
}
expect {
    2
}

test unused-cte-visible-in-limit-subquery {
    WITH c AS (SELECT 1 AS x) SELECT 42 LIMIT (SELECT x FROM c);
}
expect {
    42
}

test limit-subquery-cannot-reference-outer-column {
    SELECT x FROM (SELECT 1 AS x) LIMIT (SELECT x);
}
expect error {
    no such column: x
}

test compound-limit-cte-dependency {
    WITH a AS (SELECT 2 AS x), c AS (SELECT x FROM a)
    SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 LIMIT (SELECT x FROM c);
}
expect {
    1
    2
}

test compound-limit-inner-cte-shadows-outer {
    WITH c AS (SELECT 2 AS x)
    SELECT 1 UNION ALL SELECT 2 LIMIT (WITH c AS (SELECT 1 AS x) SELECT x FROM c);
}
expect {
    1
}

test compound-limit-subquery-cannot-reference-outer-column {
    SELECT 1 AS x UNION ALL SELECT 2 LIMIT (SELECT x);
}
expect error {
    no such column: x
}
