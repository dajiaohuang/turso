@database :memory:

test not-null-ascending-plan {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b ASC);
    EXPLAIN QUERY PLAN SELECT b FROM t WHERE a = 1 AND (b) IS NOT NULL;
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX i (a=? AND b>?)
}

test not-null-descending-plan {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b DESC);
    EXPLAIN QUERY PLAN SELECT b FROM t WHERE a = 1 AND (b) IS NOT NULL;
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX i (a=? AND b>?)
}

test not-null-results {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b DESC);
    INSERT INTO t VALUES (1, NULL), (1, 2), (1, 3), (2, 4);
    SELECT b FROM t WHERE a = 1 AND (b) IS NOT NULL ORDER BY b;
}
expect {
    2
    3
}

test not-null-desc-nulls-first-reverse {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b DESC NULLS FIRST);
    INSERT INTO t VALUES (1, NULL), (1, 2), (1, 3), (2, 4);
    SELECT b FROM t WHERE a = 1 AND (b) IS NOT NULL ORDER BY b ASC;
}
expect {
    2
    3
}

test not-null-asc-nulls-last-all-null {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b ASC NULLS LAST);
    INSERT INTO t VALUES (1, NULL), (1, NULL), (2, 4);
    SELECT count(*) FROM t WHERE a = 1 AND (b) IS NOT NULL;
}
expect {
    0
}

test not-null-upper-bound {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b DESC);
    INSERT INTO t VALUES (1, NULL), (1, 2), (1, 3), (1, 4);
    SELECT b FROM t WHERE a = 1 AND b IS NOT NULL AND b < 4 ORDER BY b;
}
expect {
    2
    3
}

test not-null-no-prefix {
    CREATE TABLE t(b INT);
    CREATE INDEX i ON t(b ASC NULLS LAST);
    INSERT INTO t VALUES (NULL), (2), (3);
    SELECT b FROM t WHERE b IS NOT NULL ORDER BY b DESC;
}
expect {
    3
    2
}

test not-null-null-on-left {
    CREATE TABLE t(b INT);
    CREATE INDEX i ON t(b);
    INSERT INTO t VALUES (NULL), (1), (2);
    SELECT b FROM t WHERE NULL IS NOT (b) ORDER BY b;
}
expect {
    1
    2
}

test not-null-does-not-change-is-not-value {
    CREATE TABLE t(b INT);
    CREATE INDEX i ON t(b);
    INSERT INTO t VALUES (NULL), (1), (2);
    SELECT coalesce(b, -1) FROM t WHERE b IS NOT 1 ORDER BY 1;
}
expect {
    -1
    2
}

test not-null-outer-join {
    CREATE TABLE l(a INT);
    CREATE TABLE r(a INT, b INT);
    CREATE INDEX i ON r(a, b);
    INSERT INTO l VALUES (1), (2), (3);
    INSERT INTO r VALUES (1, NULL), (2, 4);
    SELECT l.a FROM l LEFT JOIN r ON l.a = r.a WHERE (r.b) IS NOT NULL ORDER BY l.a;
}
expect {
    2
}

test not-null-virtual-table {
    SELECT value FROM generate_series(1, 3) WHERE value IS NOT NULL ORDER BY value;
}
expect {
    1
    2
    3
}

test ordinary-greater-null-still-matches-nothing {
    CREATE TABLE t(b INT);
    CREATE INDEX i ON t(b);
    INSERT INTO t VALUES (NULL), (1), (2);
    SELECT count(*) FROM t WHERE b > NULL;
}
expect {
    0
}

test not-null-upper-bound-plan {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b DESC);
    EXPLAIN QUERY PLAN SELECT b FROM t WHERE a = 1 AND b IS NOT NULL AND b < 4;
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX i (a=? AND b>? AND b<?)
}

test not-null-rowid-alias {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT);
    INSERT INTO t VALUES (1, 'a'), (2, 'b');
    SELECT a FROM t WHERE a IS NOT NULL ORDER BY a;
}
expect {
    1
    2
}

test not-null-text-collation {
    CREATE TABLE t(a INT, b TEXT COLLATE NOCASE);
    CREATE INDEX i ON t(a, b COLLATE NOCASE);
    INSERT INTO t VALUES (1, NULL), (1, 'a'), (1, 'B'), (2, 'c');
    SELECT b FROM t WHERE a = 1 AND b IS NOT NULL ORDER BY b;
}
expect {
    a
    B
}
