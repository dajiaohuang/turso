@database :memory:

test parenthesized-range-plan {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i1 ON t(a DESC, b DESC);
    EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1 AND (b) > (2) AND b < 7;
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX i1 (a=? AND b>? AND b<?)
}

test parenthesized-reversed-range-plan {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i1 ON t(a DESC, b DESC);
    EXPLAIN QUERY PLAN SELECT * FROM t WHERE a = 1 AND (2) < ((b)) AND b < 7;
}
expect {
    1|0|0|SEARCH t USING COVERING INDEX i1 (a=? AND b>? AND b<?)
}

test parenthesized-range-results {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i1 ON t(a DESC, b DESC);
    INSERT INTO t VALUES (1, NULL), (1, 2), (1, 3), (1, 6), (1, 7), (2, 4);
    SELECT b FROM t WHERE a = 1 AND (b) > (2) AND b < 7 ORDER BY b;
}
expect {
    3
    6
}

test parenthesized-index-collation {
    CREATE TABLE t(s TEXT COLLATE NOCASE);
    CREATE INDEX i ON t(s);
    INSERT INTO t VALUES ('a'), ('B'), ('c'), (NULL);
    SELECT s FROM t WHERE ((s)) >= ('b') ORDER BY s;
}
expect {
    B
    c
}

test parenthesized-is-true {
    CREATE TABLE t(b INT);
    CREATE INDEX i ON t(b);
    INSERT INTO t VALUES (0), (1), (2), (NULL);
    SELECT b FROM t WHERE (b) IS (TRUE) ORDER BY b;
}
expect {
    1
    2
}

test parenthesized-outer-join-null {
    CREATE TABLE l(a INT);
    CREATE TABLE r(a INT, b INT);
    CREATE INDEX i ON r(a, b);
    INSERT INTO l VALUES (1), (2);
    INSERT INTO r VALUES (1, 3);
    SELECT l.a FROM l LEFT JOIN r ON l.a = r.a WHERE (r.b) IS (NULL);
}
expect {
    2
}

test multi-column-row-comparison {
    CREATE TABLE t(a INT, b INT);
    CREATE INDEX i ON t(a, b);
    INSERT INTO t VALUES (1, 1), (1, 3), (2, 0);
    SELECT a, b FROM t WHERE (a, b) > (1, 2) ORDER BY a, b;
}
expect {
    1|3
    2|0
}
